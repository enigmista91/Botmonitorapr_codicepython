# Token GitHub con permessi repo / pull_requests / issues
GITHUB_TOKEN=ghp_your_github_personal_access_token

# Segreto configurato nel Webhook di GitHub (per la verifica HMAC SHA-256)
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# Prefissi comando riconosciuti nei commenti PR (separati da virgola)
BOT_COMMAND_PREFIXES=/bot,/ocabot

# Serie Odoo supportate e serie di default (18.0, 19.0, 20.0)
TARGET_ODOO_SERIES=18.0
SUPPORTED_ODOO_SERIES=18.0,19.0,20.0

# Impostazioni Workflow OCA
REQUIRED_APPROVALS=1
READY_TO_MERGE_MIN_DAYS=5
AUTO_LABEL=true
MENTION_MAINTAINERS=true
POST_INLINE_COMMENTS=true

# Configurazione AI Code Review (opzionale: gemini oppure openai)
AI_REVIEW_ENABLED=true
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
